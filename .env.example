# Public application origin, without a trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Standard PostgreSQL connection string. SSL is normally required by hosted databases.
DATABASE_URL=postgresql://user:password@host:5432/meshly

# Google Cloud OAuth 2.0 Web application credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Optional Dropbox app credentials. Configure a Full Dropbox app when Meshly needs
# to browse pre-existing Dropbox content. The callback must exactly match this URI.
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
DROPBOX_REDIRECT_URI=http://localhost:3000/api/auth/dropbox/callback
# Safety gate: leave false until the Dropbox encrypted round trip has been verified
# with the production app credentials. No provider token is ever exposed to the browser.
DROPBOX_MANAGED_UPLOADS_ENABLED=false

# Optional TeraBox Open Platform credentials. TeraBox issues these after an
# application request; PRIVATE_SECRET is also required by their signed token flow.
TERABOX_CLIENT_ID=
TERABOX_CLIENT_SECRET=
TERABOX_PRIVATE_SECRET=
TERABOX_APP_ROOT=/apps/meshly
# Safety gate for TeraBox managed uploads. Leave false until the production
# TeraBox app has completed an encrypted upload/download/delete round trip.
TERABOX_MANAGED_UPLOADS_ENABLED=false

# Optional dedicated ciphertext-only worker for TeraBox files that are too large
# for the serverless small-file path. Deploy workers/terabox separately first.
TERABOX_WORKER_URL=https://meshly-terabox-worker.example.com
# Independently generated 32+ character secrets shared only by the Meshly app
# and the worker. Never expose either value to browser JavaScript.
TERABOX_WORKER_SIGNING_KEY=
TERABOX_WORKER_INTERNAL_SECRET=
# Keep false until the worker is deployed and live-verified against TeraBox.
TERABOX_LARGE_WORKER_ENABLED=false

# Generate every secret independently. Never commit real values.
# 32+ random bytes as base64/text.
SESSION_SECRET=
# EXACTLY 32 random bytes encoded as base64.
TOKEN_ENCRYPTION_KEY=
# HMAC key used to sign disaster-recovery manifests.
RECOVERY_SECRET=
# HMAC key used for short-lived public-share grants.
SHARE_GRANT_SECRET=
# Vercel Cron sends this as Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=
