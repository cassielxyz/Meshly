# Meshly web
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Standard PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host:5432/meshly

# Google Cloud OAuth 2.0 Web application credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Generate each with a cryptographically secure random source.
# SESSION_SECRET: 32+ random bytes as a text/base64 secret.
SESSION_SECRET=
# TOKEN_ENCRYPTION_KEY: EXACTLY 32 random bytes encoded as base64.
TOKEN_ENCRYPTION_KEY=
