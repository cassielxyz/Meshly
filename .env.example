# Public application origin, without a trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Standard PostgreSQL connection string. SSL is normally required by hosted databases.
DATABASE_URL=postgresql://user:password@host:5432/meshly

# Google Cloud OAuth 2.0 Web application credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Generate every secret independently. Never commit real values.
# 32+ random bytes as base64/text.
SESSION_SECRET=
# EXACTLY 32 random bytes encoded as base64.
TOKEN_ENCRYPTION_KEY=
# HMAC key used to sign disaster-recovery manifests.
RECOVERY_SECRET=
# HMAC key used for short-lived public-share grants.
SHARE_GRANT_SECRET=
# Vercel Cron sends this as Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=
