    "clsx": "^2.1.1",
    "drizzle-orm": "^0.44.5",
    "hash-wasm": "4.12.0",
    "jose": "^6.1.0",
    "lucide-react": "^0.544.0",
    "motion": "^12.23.22",
    "nanoid": "^5.1.5",
    "next": "16.3.6",
    "postgres": "^3.4.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
