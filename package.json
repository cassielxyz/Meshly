{
  "name": "meshly",
  "version": "1.0.0",
  "private": true,
  "description": "One workspace for multiple Google Drive storage accounts.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
